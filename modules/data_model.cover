    1: """
       Shared, thread-safe data model for a single dyno run session.
       
       All lists grow during a run and are consumed by the plot/logger.
       Access is protected by a threading.Lock so the serial thread and
       the GUI timer can both touch it safely.
       """
       
    1: import threading
    1: import time
    1: from dataclasses import dataclass, field
    1: from enum import Enum, auto
    1: from typing import List
       
       
    2: class RunState(Enum):
    1:     IDLE = auto()
    1:     RUNNING = auto()
    1:     PAUSED = auto()
    1:     FINISHED = auto()
    1:     ERROR = auto()
       
       
    3: @dataclass
    2: class Sample:
    1:     """One recorded data point."""
    1:     elapsed_s: float
    1:     torque_nm: float
    1:     rpm: float
    1:     dac_raw: int        # 0-4095 value sent to MCP4725
    1:     adc_raw: int        # 0-1023 raw reading from Arduino analog pin
       
       
    2: class DynoSession:
    1:     """
           Accumulates samples for a single dyno run.
       
           Thread-safe: use append_sample() / get_snapshot() from any thread.
           """
       
    1:     def __init__(self) -> None:
               self._lock = threading.Lock()
               self._samples: List[Sample] = []
               self._start_time: float | None = None
               self.state: RunState = RunState.IDLE
       
           # ------------------------------------------------------------------
           # Lifecycle
           # ------------------------------------------------------------------
       
    1:     def start(self) -> None:
               with self._lock:
                   self._samples.clear()
                   self._start_time = time.perf_counter()
                   self.state = RunState.RUNNING
       
    1:     def finish(self) -> None:
               with self._lock:
                   self.state = RunState.FINISHED
       
    1:     def reset(self) -> None:
               with self._lock:
                   self._samples.clear()
                   self._start_time = None
                   self.state = RunState.IDLE
       
           # ------------------------------------------------------------------
           # Writing
           # ------------------------------------------------------------------
       
    1:     def append_sample(self, sample: Sample) -> None:
               with self._lock:
                   self._samples.append(sample)
       
    1:     def elapsed_seconds(self) -> float:
               """Seconds since start(), or 0 if not started."""
               if self._start_time is None:
                   return 0.0
               return time.perf_counter() - self._start_time
       
           # ------------------------------------------------------------------
           # Reading (returns copies — safe to use outside lock)
           # ------------------------------------------------------------------
       
    1:     def get_snapshot(self) -> List[Sample]:
               """Return a shallow copy of all samples so far."""
               with self._lock:
                   return list(self._samples)
       
    1:     def sample_count(self) -> int:
               with self._lock:
                   return len(self._samples)
       
    1:     def last_sample(self) -> Sample | None:
               with self._lock:
                   return self._samples[-1] if self._samples else None
