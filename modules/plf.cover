    1: """
       Piecewise Linear Function (PLF) module.
       
       Loads a CSV with columns [time_s, torque_nm] and provides
       linear interpolation of torque at any arbitrary time.
       
       CSV format (header row required):
           time_s,torque_nm
           0.0,0.0
           5.0,10.5
           10.0,20.0
           ...
       """
       
    1: import csv
    1: from pathlib import Path
       
    1: import numpy as np
       
       
    2: class PLFError(Exception):
    1:     """Raised when the PLF CSV is malformed or cannot be loaded."""
       
       
    2: class PiecewiseLinearFunction:
    1:     """
           Linear interpolator built from a (time_s, torque_nm) CSV file.
       
           Attributes
           ----------
           times   : 1-D numpy array of time values (seconds), monotonically increasing.
           torques : 1-D numpy array of corresponding torque values (N·m).
           duration: Total duration of the profile (seconds).
           """
       
    1:     REQUIRED_COLUMNS = {"time_s", "torque_nm"}
       
    1:     def __init__(self) -> None:
               self.times: np.ndarray = np.array([])
               self.torques: np.ndarray = np.array([])
               self.duration: float = 0.0
               self._loaded: bool = False
       
           # ------------------------------------------------------------------
           # Loading
           # ------------------------------------------------------------------
       
    1:     def load_csv(self, filepath: str | Path) -> None:
               """
               Parse *filepath* and build the interpolation table.
       
               Raises
               ------
               PLFError  on missing columns, non-numeric data, or non-monotonic times.
               FileNotFoundError if the file does not exist.
               """
               filepath = Path(filepath)
               if not filepath.exists():
                   raise FileNotFoundError(f"CSV file not found: {filepath}")
       
               times: list[float] = []
               torques: list[float] = []
       
               with filepath.open(newline="") as fh:
                   reader = csv.DictReader(fh)
                   if reader.fieldnames is None:
                       raise PLFError("CSV file is empty or has no header row.")
       
                   header = {c.strip().lower() for c in reader.fieldnames}
                   if not self.REQUIRED_COLUMNS.issubset(header):
                       missing = self.REQUIRED_COLUMNS - header
                       raise PLFError(
                           f"CSV is missing required columns: {missing}. "
                           f"Found: {set(reader.fieldnames)}"
                       )
       
                   for line_num, row in enumerate(reader, start=2):
                       try:
                           t = float(row["time_s"].strip())
                           q = float(row["torque_nm"].strip())
                       except (ValueError, KeyError) as exc:
                           raise PLFError(
                               f"Non-numeric value on line {line_num}: {exc}"
                           ) from exc
                       times.append(t)
                       torques.append(q)
       
               if len(times) < 2:
                   raise PLFError("PLF requires at least 2 data points.")
       
               t_arr = np.array(times, dtype=float)
               if not np.all(np.diff(t_arr) > 0):
                   raise PLFError("time_s values must be strictly increasing.")
       
               self.times = t_arr
               self.torques = np.array(torques, dtype=float)
               self.duration = float(self.times[-1])
               self._loaded = True
       
           # ------------------------------------------------------------------
           # Query
           # ------------------------------------------------------------------
       
    1:     def torque_at(self, time_s: float) -> float:
               """
               Return the linearly interpolated torque (N·m) at *time_s*.
       
               Times before the profile start return the first torque value.
               Times after the profile end return the last torque value (clamp).
               """
               if not self._loaded:
                   raise RuntimeError("No PLF loaded. Call load_csv() first.")
               return float(np.interp(time_s, self.times, self.torques))
       
    1:     def is_loaded(self) -> bool:
               return self._loaded
       
    1:     def summary(self) -> str:
               if not self._loaded:
                   return "No profile loaded."
               return (
                   f"{len(self.times)} points | "
                   f"duration={self.duration:.2f} s | "
                   f"torque=[{self.torques.min():.2f}, {self.torques.max():.2f}] N·m"
               )
