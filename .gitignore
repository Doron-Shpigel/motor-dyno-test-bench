# =============================================================================
# Motor Dyno Test Bench - .gitignore
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C / C++ compiled binaries and build artifacts
*.o
*.obj
*.so
*.dylib
*.dll
*.exe
*.out
*.app
arduino/**/mock_test/test
arduino/**/mock_test/test[0-9]*
arduino/**/mock_test/test*debug
arduino/**/mock_test/test_edge_cases
arduino/**/mock_test/*.o

# Coverage and testing artifacts
.coverage
.coverage.*
*.cover
htmlcov/
.pytest_cache/
.tox/
.nox/

# Distribution / packaging / builds
dist/
build/
*.egg-info/
*.egg
eggs/
.eggs/
release/
releases/
*.zip
*.tar.gz

# Environments & virtual environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Project-specific transient/scratch files
temp_run.csv
temp_*.csv
*.log

# Agent & internal workspace scratchpad artifacts
.agents/

# IDE / Editor configuration
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
